# Summon Experts Enhanced AutoGen Service Environment Variables
# Copy this file to .env and fill in your actual API keys

# Required: AI API Keys
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Optional: Model overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Optional: Web Search API (Serper - Google Search)
SERPER_API_KEY=your_serper_api_key_here
WEB_SEARCH_API_KEY=your_web_search_api_key_here

# Optional: Service configuration
PORT=5057
HOST=0.0.0.0
DEBUG=true

# Optional: Database configuration
DATABASE_URL=sqlite:///./summon_experts.db

# Optional: Security (for production)
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Optional: CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,https://summonexperts.com

# Optional: Session management
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=10

# Optional: Logging
LOG_LEVEL=INFO
LOG_FILE=summon_experts.log
